import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import assert from 'node:assert/strict';import {execFileSync} from 'node:child_process';import {pathToFileURL} from 'node:url';import {createHash} from 'node:crypto'
import {createBattle} from '../src/core/setup.js';import {advanceBattle,completeActionCycle,runBattle} from '../src/core/battle.js';import {runActivation} from '../src/ai/modes.js';import {movementOptions,nearestEnemy,movePowerOf} from '../src/core/movement.js';import {forkBattle} from '../src/core/fork.js';import {MAP_PANEL} from '../src/content/maps.js';import {battleCursorCases} from '../test/battle-cursor-cases.js'
function verifyChoice(row:any,before:any[],after:any[]){
 const i=before.findIndex((e,j)=>JSON.stringify(e)!==JSON.stringify(after[j]));assert.ok(i>=0,'must contain a first divergence');const a=before[i],b=after[i]
 assert.equal(a.type,'move.begin');assert.equal(b.type,'move.begin');assert.equal(a.actor,row.actor);assert.equal(b.actor,row.actor);assert.equal(a.causeId,b.causeId)
 assert.equal(a.from,row.from);assert.equal(b.from,row.from);assert.equal(a.to,row.old.hex);assert.equal(b.to,row.best.hex)
 assert.equal(a.hexes,row.old.path.length);assert.equal(b.hexes,row.best.path.length)
