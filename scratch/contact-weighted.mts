import {createBattle} from '../src/core/setup.js';import {beginActivation} from '../src/core/mutate.js';import {movementOptions,stepCost} from '../src/core/movement.js';
const found=new Set();for(let k=0;k<100&&found.size<2;k++){const rows=Array.from({length:5},(_,r)=>Array.from({length:8},(_,c)=>(r*8+c)*17%29<k%15?'h':'.').join(''));for(let hero=9;hero<29;hero++){const enemy=hero+4;if(enemy>=40)continue;const ctx=createBattle({map:{id:'test.tie',name:'Tie',rows},replicate:0,heroes:['test-warrior'],enemies:['unit.zombie'],heroHexes:[hero],enemyHexes:[enemy]});beginActivation(ctx,1,'test');const ps=movementOptions(ctx,1,'power.move').map(p=>({...p,d:ctx.geo.distance(p.destination,hero),cost:p.path.reduce((v,h,i)=>v+stepCost(ctx,h,i?p.path[i-1]:enemy),0)})).filter(p=>p.d<ctx.geo.distance(enemy,hero));const bycost=[...ps].sort((a,b)=>a.d-b.d||a.cost-b.cost||a.destination-b.destination)[0],best=[...ps].sort((a,b)=>a.d-b.d||a.cost-b.cost||a.path.length-b.path.length||a.destination-b.destination)[0],bylen=[...ps].sort((a,b)=>a.d-b.d||a.path.length-b.path.length||a.destination-b.destination)[0];if(!best)continue;for(const [tag,other]of [['length',bycost],['cost',bylen]] as const){if(!found.has(tag)&&other.destination!==best.destination){found.add(tag);console.log({tag,rows,hero,enemy,best:[best.destination,best.cost,best.path],other:[other.destination,other.cost,other.path]})}}}}

