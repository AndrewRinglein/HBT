const heroByClassName = (cls, name) => HEROES.heroes.find(h => h.class === cls && h.path === 'base' && h.name === name);

// Weapon-tag affinity. Vocabulary taken from weapons.json: axe spear hammer chain thrown
// shield improvised crossbow claw sword blade 2-hander polearm exotic dagger sling wand
// magic tome holy bow staff brawl melee fang ranged breath.
const TAGFIT = {
  'class.warrior': {axe:6,greatsword:6,sword:5,polearm:5,'2-hander':4,spear:4,hammer:4,blade:4,shield:5,chain:3,brawl:3,melee:2,improvised:1,exotic:1,claw:1,thrown:1,dagger:1,crossbow:0,bow:0,sling:0,staff:0,wand:0,tome:0,magic:0,holy:0,fang:0,ranged:0,breath:0},
  'class.paladin': {hammer:6,shield:6,sword:5,blade:4,holy:5,'2-hander':4,axe:3,polearm:3,spear:3,chain:3,melee:2,brawl:1,dagger:1,tome:1,staff:1,exotic:1,improvised:0,claw:0,thrown:0,crossbow:0,bow:0,sling:0,wand:0,magic:0,fang:0,ranged:1,breath:0},
  'class.ranger':  {bow:7,crossbow:6,ranged:5,sling:4,thrown:4,spear:3,blade:2,sword:2,dagger:2,claw:1,axe:1,exotic:1,melee:1,polearm:1,brawl:0,chain:0,shield:0,staff:0,wand:0,tome:0,magic:0,holy:0,'2-hander':0,hammer:0,improvised:0,fang:0,breath:0},
  'class.rogue':   {dagger:7,blade:5,claw:5,thrown:5,sword:3,crossbow:3,sling:3,bow:2,exotic:2,melee:2,brawl:2,improvised:2,chain:2,spear:1,wand:1,fang:1,axe:1,magic:1,polearm:0,shield:0,staff:0,tome:0,holy:0,'2-hander':0,hammer:0,ranged:1,breath:0},
  'class.mage':    {staff:7,wand:7,tome:6,magic:6,breath:4,dagger:3,sling:2,exotic:2,holy:1,sword:1,blade:1,mace:1,improvised:1,ranged:1,thrown:1,brawl:0,chain:0,claw:0,crossbow:0,bow:0,spear:0,axe:0,hammer:0,polearm:0,shield:0,'2-hander':0,melee:0,fang:0},
  'class.priest':  {holy:7,tome:6,staff:6,hammer:4,wand:4,magic:3,shield:3,chain:3,blade:2,sword:2,melee:2,brawl:1,dagger:1,spear:1,axe:1,polearm:1,improvised:1,exotic:1,sling:1,'2-hander':1,bow:0,crossbow:0,claw:0,thrown:0,fang:0,ranged:0,breath:0},
};
const ARMORFIT = { 'class.warrior':{heavy:3,medium:2,light:0}, 'class.paladin':{heavy:3,medium:2,light:0},
  'class.ranger':{heavy:-1,medium:2,light:2}, 'class.rogue':{heavy:-2,medium:1,light:3},
  'class.mage':{heavy:-3,medium:0,light:3}, 'class.priest':{heavy:1,medium:2,light:1} };

function weightOf(item) {                          // armorWeight / the light|medium|heavy tag; else read the penalties
  if (item.armorWeight) return item.armorWeight;
  for (const t of item.tags ?? []) if (t === 'light' || t === 'medium' || t === 'heavy') return t;
  const m = item.statModifiers ?? {};
  const pen = (m.movement ?? 0) + (m.dodge ?? 0) / 10 + (m.accuracy ?? 0) / 10;
  return pen <= -2 ? 'heavy' : pen <= -0.5 ? 'medium' : 'light';
}
function score(item, cls) {
  if (item.classRestriction) {                     // rows spell it \"class.priest\"; accept the bare form too
    const r = String(item.classRestriction).toLowerCase();
    if (r !== cls && r !== cls.split('.')[1]) return -Infinity;
  }
  const w = W[cls]; let s = 0;
  for (const [k, v] of Object.entries(item.statModifiers ?? {})) s += (w[k] ?? 0) * v;
  if (item.itemClass === 'weapon') {
    const fit = Math.max(0, ...(item.tags ?? []).map(t => TAGFIT[cls][t] ?? 0), 0);
    s += fit * 1.6;
    if (fit === 0) s -= 3;                         // wrong weapon for the class
  }
  if (item.itemClass === 'armor') s += (ARMORFIT[cls][weightOf(item)] ?? 0) * 1.4;
  s += (item.triggers?.length ?? 0) * 1.1 + (item.slayer ? 1 : 0);
  s += (item.tier ?? 0) * 2.0;   // \"the highest tier they can get\" — but class fit still dominates
  if (Object.keys(item.equipCost ?? {}).length) s -= 0.4;   // faith / crystals to field it
  return s;
}

// ---------- level maths ----------
const STATS = ['strength','precision','magic','spirit','armor','resist','health','reach','dodge',
  'toughness','itemSlots','accuracy','crit','luck','vision','movement','staminaMax','staminaRegen','surge'];
const levelRows = cls => LEVELS.classes.find(c => c.id === cls);

function levelGains(cls, level) {                  // everything levels 2..level grant
  const c = levelRows(cls), out = {}, picks = [];
  for (const row of c.rows.filter(r => r.level >= 2 && r.level <= level)) {
    for (const [k, v] of Object.entries(c.freebie ?? {})) out[k] = (out[k] ?? 0) + v;
    for (const [k, v] of Object.entries(row.grants ?? {})) out[k] = (out[k] ?? 0) + v;
    if (row.choice) {                              // L5: take the option this class values most
      const best = row.choice.options.map(o => ({ o, s: Object.entries(o).reduce((a, [k, v]) => a + (W[cls][k] ?? 0) * v, 0) }))
        .sort((a, b) => b.s - a.s)[0].o;
      for (const [k, v] of Object.entries(best)) out[k] = (out[k] ?? 0) + v;
      picks.push({ level: row.level, pick: best });
    }
  }
  return { out, picks };
}
function powersFor(cls, level) {                   // one class power at L3, L4, L5, L6
  const def = CLASSDEF[cls], spec = SPECIALTY[cls];
  const mine = def.powers.filter(p => p.specialty === spec);
  const other = def.powers.filter(p => p.specialty !== spec)
    .sort((a, b) => (a.stamina ?? 0) - (b.stamina ?? 0));
  const order = [...mine, ...other];
  const out = [];
  for (const lv of [3, 4, 5, 6]) if (level >= lv) {
    const p = order[out.length];
    if (p) out.push({ level: lv, id: p.id, name: p.name, specialty: p.specialty,
      stamina: p.stamina ?? 0, cooldown: p.cooldown ?? 0, description: p.description });
  }
  return out;
}
function specialtyMods(cls) {
  const s = CLASSDEF[cls].specialties.find(x => x.id === SPECIALTY[cls]);
  return { id: s.id, name: s.name ?? s.id, mods: s.statModifiers ?? {} };
}

// ---------- hero objects ----------
function makeHero(cls, name) {
  const src = heroByClassName(cls, name);
  if (!src) throw new Error(`no base hero ${name} for ${cls}`);
  const base = { ...src.ported, ...src.derivedBase, surge: 0 };
  for (const k of STATS) base[k] ??= 0;
  delete base.bleedOutTurns;
  return { id: src.id, name: src.name, class: cls, className: src.sourceClass, level: 1,
    base, specialty: null, powers: [], hands: [], armor: null, slots: [], joined: 0, fielded: false };
}
const party = ROSTER.map(([cls, name]) => makeHero(cls, name));
party[0].level = 3;   // Warrior
party[1].level = 2;   // Ranger
party[3].level = 2;   // Priest
party.forEach((h, i) => { h.fielded = i < fieldCount(1); h.entryOrder = i + 1; });

// starting kits (kits.json draw specs, rolled here)
const KITS = R('kits.json').classKits;
const stash = [];
for (const h of party) {
  const k = KITS[h.class], pool = k.startPool.map(id => norm(BASE.get(id))).filter(Boolean);
  const drawn = [];
  if (k.draw === 'two-hands-worth') {
    const first = take(pool); drawn.push(first);
    if (first.hands < 2) drawn.push(take(pool));
  } else drawn.push(take(pool));
  const armor = pick(T0_ARMOR.filter(a => a.classRestriction === null));
  h.kit = [...drawn, armor].map(i => i.id);
  stash.push(...drawn, armor);
}

// ---------- the reward stream ----------
const t3w = [...POOL_T3_W], t3a = [...POOL_T3_A];
const t1 = { trinket: [...POOL_T1.trinket], idol: [...POOL_T1.idol],
             bloodrune: [...POOL_T1.bloodrune], relic: [...POOL_T1.relic] };
const shelf = [...SHELF_T1];
const drawT3 = () => roll([['weapon', 25], ['armor', 25]]) === 'weapon' ? take(t3w) : take(t3a);
const drawT1 = () => take(t1[roll([['trinket', 20], ['idol', 10], ['bloodrune', 10], ['relic', 10]])]);
const drawShelf = () => take(shelf);

// pre-battle-1 state: three tier-3 reward items, three bought tier-1
const opening = { tier3: [drawT3(), drawT3(), drawT3()], bought: [drawShelf(), drawShelf(), drawShelf()] };
stash.push(...opening.tier3, ...opening.bought);

// ---------- assignment ----------
function statsOf(h, equipped) {
  const { out: lv } = levelGains(h.class, h.level);
  const sp = h.level >= 2 ? specialtyMods(h.class).mods : {};
  const gear = merge(...equipped.map(i => i.statModifiers));
  const total = {};
  for (const k of STATS) total[k] = (h.base[k] ?? 0) + (lv[k] ?? 0) + (sp[k] ?? 0) + (gear[k] ?? 0);
  return total;
}
function capacity(h) {
  const { out } = levelGains(h.class, h.level);
  const sp = h.level >= 2 ? specialtyMods(h.class).mods : {};
  return { hands: 2, armor: 1, slots: Math.max(0, (h.base.itemSlots ?? 0) + (out.itemSlots ?? 0) + (sp.itemSlots ?? 0)) };
}
const CAPPED = new Set(['idol', 'bloodrune', 'relic']);

function assignAll(fielded, pool) {
  const state = new Map(fielded.map(h => [h.id, { hands: [], armor: null, slots: [], cap: capacity(h), caps: {} }]));
  const used = new Set();
  const slotsUsed = st => st.slots.reduce((a, x) => a + (x.slots || 1), 0);
  const handsUsed = st => st.hands.reduce((a, x) => a + (x.hands === 2 ? 2 : 1), 0);
  const rank = kinds => {
    const out = [];
    for (const it of pool) { if (used.has(it.id) || !kinds.includes(it.itemClass)) continue;
      for (const h of fielded) { const sc = score(it, h.class); if (sc > -Infinity) out.push({ it, h, s: sc }); } }
    return out.sort((a, b) => b.s - a.s || a.it.id.localeCompare(b.it.id));
  };

  // PHASE 1 — the primary weapon set. Hands only: one two-hander, or two one-handers/shield.
  for (const { it, h } of rank(['weapon'])) {
    if (used.has(it.id)) continue;
    const st = state.get(h.id), need = it.hands === 2 ? 2 : 1;
    if (handsUsed(st) + need <= st.cap.hands) { st.hands.push(it); used.add(it.id); }
  }
  // PHASE 2 — armor.
  for (const { it, h, s } of rank(['armor'])) {
    if (used.has(it.id)) continue;
    const st = state.get(h.id);
    if (!st.armor && s > 0) { st.armor = it; used.add(it.id); }
  }
  // PHASE 3 — item slots go to trinkets, idols, Bloodrunes and relics, never to spare weapons.
  for (const { it, h, s } of rank(['trinket', 'idol', 'bloodrune', 'relic'])) {
    if (used.has(it.id)) continue;
    const st = state.get(h.id);
    if (CAPPED.has(it.itemClass) && st.caps[it.itemClass]) continue;
    if (s > 0 && slotsUsed(st) + (it.slots || 1) <= st.cap.slots) {
      st.slots.push(it); used.add(it.id);
      if (CAPPED.has(it.itemClass)) st.caps[it.itemClass] = true;
    }
  }
  // PHASE 4 — only now may a spare weapon take a slot, and only a one-handed one, one per hero.
  for (const { it, h, s } of rank(['weapon'])) {
    if (used.has(it.id)) continue;
    const st = state.get(h.id);
    if (it.hands === 2 || st.slots.some(x => x.itemClass === 'weapon')) continue;
    if (s > 0 && slotsUsed(st) + (it.slots || 1) <= st.cap.slots) { st.slots.push(it); used.add(it.id); }
  }

  if (process.env.DEBUG_ASSIGN) {
    for (const it of pool.filter(i => !used.has(i.id))) {
      if (!['idol', 'relic', 'trinket', 'bloodrune'].includes(it.itemClass)) continue;
      console.error(`[unassigned] ${it.name} (${it.itemClass}) -> ` + fielded.map(h => {
        const st = state.get(h.id);
        return `${h.name}: s=${score(it, h.class).toFixed(1)} ${slotsUsed(st)}/${st.cap.slots}` +
          (CAPPED.has(it.itemClass) && st.caps[it.itemClass] ? ' CAPPED' : '');
      }).join(' | '));
    }
  }
  return { state, unassigned: pool.filter(i => !used.has(i.id)) };
}

// ---------- run the 20 battles ----------
const BATTLES = 20;
const benchNames = { 'class.warrior': ['Skullplate Veteran','Mountain Berserker','Dwarven Brawler'],
  'class.ranger': ['Forest Fey','Ancient Elf','Forest Elf'], 'class.rogue': ['The Rose','The Skull','The Serpent'],
  'class.mage': ['Pyre Witch','Archive Scholar','Crimson Sorceress'],
  'class.priest': ['Barefoot Mendicant','Cathedral Bishop','Rune-Marked Ascetic'],
  'class.paladin': ['Black Oath','Dawnblade','Court Champion'] };
const recruitQueue = [];
for (let i = 0; i < 3; i++) for (const c of Object.keys(benchNames)) recruitQueue.push([c, benchNames[c][i]]);

const bench = [], battles = [];
for (let b = 1; b <= BATTLES; b++) {
  party.forEach((h, i) => { h.fielded = i < fieldCount(b); });   // 4 -> 5 (b5) -> 6 (b11)
  const fielded = party.filter(h => h.fielded);
  const { state, unassigned } = assignAll(fielded, stash);

  const roster = fielded.map(h => {
    const st = state.get(h.id);
    const equipped = [...st.hands, ...(st.armor ? [st.armor] : []), ...st.slots];
    const sp = h.level >= 2 ? specialtyMods(h.class) : null;
    const { picks } = levelGains(h.class, h.level);
    return { id: h.id, name: h.name, class: h.class, className: h.className, level: h.level,
      specialty: sp && { id: sp.id, mods: sp.mods },
      levelFivePick: picks[0]?.pick ?? null,
      powers: powersFor(h.class, h.level),
      equipment: { hands: st.hands.map(i => ({ id: i.id, name: i.name, tier: i.tier })),
