  const gained = { tier3: drawT3(), tier1: drawT1() };
  const levelTarget = fielded.slice().sort((a, b) => a.level - b.level || party.indexOf(a) - party.indexOf(b))[0];
  const recruit = (b % 2 === 0 && recruitQueue.length) ? recruitQueue.shift() : null;

  battles.push({ battle: b, fieldedCount: fielded.length, roster,
    stashCount: unassigned.length,
    stash: unassigned.map(i => ({ id: i.id, name: i.name, tier: i.tier, itemClass: i.itemClass })),
    afterBattle: { levelUp: { hero: levelTarget.name, from: levelTarget.level, to: levelTarget.level + 1 },
      rewards: [{ id: gained.tier3.id, name: gained.tier3.name, tier: 3, itemClass: gained.tier3.itemClass },
                { id: gained.tier1.id, name: gained.tier1.name, tier: 1, itemClass: gained.tier1.itemClass }],
      recruit: recruit ? { class: recruit[0], name: recruit[1] } : null } });

  levelTarget.level += 1;
  stash.push(gained.tier3, gained.tier1);
  if (recruit) { const h = makeHero(recruit[0], recruit[1]); h.joined = b; bench.push(h); }
}

