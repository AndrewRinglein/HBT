# The gate only ever appends to these two, so when two workers land in separate copies
# of the folder, git keeps both sides' new lines instead of stopping on a conflict
# (Andrew, 2026-10-01). Lines from each side stay in their own order.
.state/ledger.md merge=union
.state/gauntlet-log.jsonl merge=union
# What passed on which code (engine/tools/suites.mjs, 2026-10-04). Append-only, so when two workers
# record a pass in separate copies of the folder, git keeps both sides' lines instead of stopping.
.state/passes.jsonl merge=union
# The tests that timed out twice (tools/suites.mjs, tool.landing-on-the-quick-check, 2026-10-06). Append-only, like
# the pass records: two copies' lines both survive a merge.
.state/timed-out-twice.jsonl merge=union
