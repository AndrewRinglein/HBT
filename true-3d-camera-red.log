    /* The battle viewer's stylesheet — owned here (THREE-PACKAGES-PLAN stage 1).
       Lifted 2026-09-02 from VFX/BATTLE-SCREEN-V1.html (the mock the packer used
       to harvest CSS from) plus the shell rules pack.py carried inline. "art/" image references
       are rewritten to data URIs by tools/build-viewer.mjs for the
       standalone page, and left as paths for a folder build. */
    
    *{box-sizing:border-box}
    :root{
      --panel:#191713; --border:#332c22; --plate:#15120d; --ink:#e8e5dc; --dim:#8b8778;
      --brass:#d6b25e; --gold:#e0b95e; --violet:#a964d8; --ember:#d1665c; --steel:#7f9ec0;
      --tilt:49.3deg; --anti:-49.3deg;
      --hp:#7ec45f; --prot:#5aa8d8;
    }
    html,body{margin:0;background:#08090b;color:var(--ink);
      font:14px/1.5 "Barlow Semi Condensed",ui-sans-serif,system-ui,sans-serif;
      -webkit-font-smoothing:antialiased}
    .mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
    
    /* ── shell ─────────────────────────────────────────────────────────────── */
    #fitwrap{width:100%;overflow:hidden}
    #screen{width:1920px;height:1080px;position:relative;background:#0b0c0e;
      transform-origin:0 0;display:flex;overflow:hidden;user-select:none}
    #left{width:1448px;height:1080px;position:relative;display:flex;flex-direction:column;
      background:#101114;overflow:hidden}
    
    /* ── top bar + initiative rail ─────────────────────────────────────────── */
    #topbar{height:74px;flex:0 0 74px;display:flex;align-items:center;gap:18px;
      padding:0 18px;background:linear-gradient(#16130f,#100e0b);
      border-bottom:2px solid var(--brass);position:relative;z-index:40}
    #turnchip{font-family:Spectral,serif;font-size:22px;font-weight:600;letter-spacing:.4px}
    #phasechip{font-size:11px;letter-spacing:.14em;text-transform:uppercase;font-weight:600;
      padding:4px 11px;border-radius:2px;background:#2a2110;color:var(--gold);border:1px solid #4a3a1c}
    #phasechip.enemy{background:#241a2e;color:var(--violet);border-color:#3f2a52}
    /* 2026-09-03: the encounter's title and the enemy side's Power pool, both folded */
    #encchip{font-family:Spectral,serif;font-size:15px;font-weight:600;color:#cbc3ae;letter-spacing:.3px;
      padding:4px 10px;border-left:1px solid var(--border)}
    #powerchip{font-size:11px;letter-spacing:.14em;text-transform:uppercase;font-weight:600;
      padding:4px 11px;border-radius:2px;background:#2a1030;color:#e2a8ff;border:1px solid #5a2a7a}
    #seedline{margin-left:auto;font-size:11.5px;color:var(--dim);text-align:right;line-height:1.35}
    #rail{display:flex;gap:6px;align-items:flex-end}
    .railchip{width:44px;height:52px;border-radius:2px;overflow:hidden;position:relative;
      border:1px solid #2b2419;background:#0e0c09;cursor:pointer;transition:border-color .15s}
    .railchip img{position:absolute;left:50%;bottom:2px;transform:translateX(-50%);height:46px;width:auto}
    .railchip.hero{border-bottom:3px solid var(--gold)}
    .railchip.enemy{border-bottom:3px solid var(--violet)}
    .railchip.act{border-color:#bff2ff;box-shadow:0 0 0 1px #bff2ff, 0 0 10px rgba(191,242,255,.5)}
    .railchip.gone{filter:grayscale(1) brightness(.4)}
    .railno{position:absolute;top:1px;left:3px;font-size:9px;color:#c9c2b2;
      text-shadow:0 1px 2px #000;font-weight:600}
    
    /* ── board ─────────────────────────────────────────────────────────────── */
    #boardwrap{flex:1 1 auto;position:relative;overflow:hidden;background:#0d0e10}
    #boardwrap::after{content:"";position:absolute;inset:0;pointer-events:none;
      background:radial-gradient(ellipse at 50% 46%,transparent 52%,rgba(4,5,7,.72) 100%)}
    #stage{position:absolute;left:50%;top:50%;transform-style:preserve-3d;
      transition:transform .55s cubic-bezier(.4,0,.2,1)}
    .cell,.ring,.lay{position:absolute;width:128px;height:132px}
    .cell{clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);
      background-size:cover;background-position:center}
    .hit{position:absolute;width:128px;height:132px;
      clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);cursor:pointer}
    .ring{clip-path:polygon(64px 0px,128px 33px,128px 99px,64px 132px,0px 99px,0px 33px,64px 0px,64px 7px,9px 37px,9px 95px,64px 125px,119px 95px,119px 37px,64px 7px)}
    .lay{clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}
    .grid{background:rgba(214,178,94,.13)}
    .hover{background:rgba(255,240,200,.55);filter:drop-shadow(0 0 3px rgba(0,0,0,.8))}
    .reach{background:rgba(126,196,95,.10)}
    .reachEdge{background:rgba(150,220,120,.42)}
    
    /* ── 2026-09-03 board objects: painted layers, corpses, auras, the banner ── */
    .lay.dark{mix-blend-mode:normal}
    .lay.aura{pointer-events:none}
    .corpse{position:absolute;width:0;height:0;transform-style:preserve-3d;pointer-events:none}
    .banner{position:absolute;left:50%;top:18px;transform:translate(-50%,0);z-index:52;pointer-events:none;
      padding:9px 22px;background:rgba(8,9,11,.82);border:1px solid #3a3323;border-radius:3px;text-align:center;
      box-shadow:0 10px 28px rgba(0,0,0,.6)}
    .banner b{display:block;font-family:Spectral,serif;font-size:22px;font-weight:600;color:#e8e5dc;letter-spacing:.3px}
    .banner span{display:block;font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:#8b8778;margin-top:2px}
    .banner.wave b,.banner.night b{color:#e2a8ff}
    .banner.band b{color:#ff9d3c}
    .banner.won b{color:var(--gold)}
    .banner.lost b{color:#ff8f8f}
    /* DEATHBED FIGHTING — the modal (Angela 2026-09-03 evening) */
    .dbModal{position:absolute;inset:0;z-index:60;pointer-events:none;display:flex;align-items:center;justify-content:center}
    .dbVeil{position:absolute;inset:0;background:rgba(4,4,6,.62)}
    .dbPlate{position:relative;min-width:420px;padding:26px 44px;text-align:center;background:#14120e;border:2px solid #6b5a33;border-radius:4px;
      box-shadow:0 18px 48px rgba(0,0,0,.8),inset 0 0 0 1px #2a251d}
    .dbPlate span{display:block}
    .dbHead{font-size:13px;letter-spacing:.22em;text-transform:uppercase;font-weight:700;color:#cbc3ae}
    .dbSub{font-family:Spectral,serif;font-size:30px;font-weight:600;color:#e8e5dc;margin-top:6px}
    .dbBold{font-family:Spectral,serif;font-size:40px;font-weight:600;margin-top:6px;letter-spacing:.2px}
    .dbName{font-size:14px;color:#8b8778;margin-top:10px}
    .dbRoll{font-size:16px;color:#a9a394;margin-top:4px}
    .dbRoll b{color:#e8e5dc}
    .dbHead.gold,.dbBold.gold{color:var(--gold);text-shadow:0 0 18px rgba(224,185,94,.45)}
    .dbHead.red,.dbBold.red{color:#ff8f8f}
    .dbPlate.stood{border-color:var(--gold)}
    .dbPlate.fell,.dbPlate.exhausted{border-color:#7a2c2c}
    /* THE DEATHBED SKULL (Angela 2026-09-04): very small, red, in the overhead
       status row — never the health bar's bone-white projection skull (§3.1) */
    .badge.dbSkull{display:flex;align-items:center;justify-content:center;width:15px;height:19px;
      filter:drop-shadow(0 1px 2px rgba(0,0,0,.9))}
    
    /* billboards */
    .bb{position:absolute;transform-origin:50% 100%;transform:rotateZ(var(--unspin, 0deg)) rotateX(var(--anti));
      transform-style:preserve-3d;pointer-events:none}
    .tok{display:block;width:auto;pointer-events:auto;cursor:pointer}
    .shadow{position:absolute;border-radius:50%;background:rgba(0,0,0,.55);filter:blur(7px)}
    .fring{position:absolute;border-radius:50%;border:3px solid;pointer-events:none}
    /* SELECTED — what the panel is showing. Quiet, cool, never faction-coloured so it
       cannot be buried by a gold hero aura. This is a UI state, not a game state. */
    .sel{position:absolute;border-radius:50%;border:2px solid #bff2ff;
      box-shadow:0 0 10px rgba(191,242,255,.6);animation:selPulse 1.9s ease-in-out infinite}
    @keyframes selPulse{0%,100%{opacity:.65}50%{opacity:.95}}
    
    /* ACTIVE — whose Activation this is. A GAME state, and it must out-shout the
       selection ring. Four candidates; flip them in the control bar. */
    .act-a{position:absolute;border-radius:50%;
      background:radial-gradient(ellipse at 50% 50%,rgba(255,236,190,.42) 0%,rgba(255,206,110,.20) 52%,transparent 74%);
      box-shadow:0 0 26px rgba(255,206,110,.45)}
    .act-a2{position:absolute;border-radius:50%;border:3px solid rgba(255,226,150,.95);
      animation:actSweep 2.4s linear infinite}
    @keyframes actSweep{0%{clip-path:polygon(50% 50%,50% 0,100% 0,100% 50%)}
      25%{clip-path:polygon(50% 50%,100% 0,100% 100%,50% 100%)}
      50%{clip-path:polygon(50% 50%,100% 100%,0 100%,0 50%)}
      75%{clip-path:polygon(50% 50%,0 100%,0 0,50% 0)}
      100%{clip-path:polygon(50% 50%,50% 0,100% 0,100% 50%)}}
    .act-b1{position:absolute;border-radius:50%;border:3px solid;animation:actB 2.2s ease-in-out infinite}
    .act-b2{position:absolute;border-radius:50%;border:2px solid;opacity:.6}
    @keyframes actB{0%,100%{opacity:.7;transform:scale(1)}50%{opacity:1;transform:scale(1.045)}}
    .act-c{position:absolute;border-radius:50%;border:4px dashed rgba(255,232,170,.95);
      animation:actSpin 7s linear infinite}
    @keyframes actSpin{to{transform:rotate(360deg)}}
    .act-d{position:absolute;border-radius:50%;
      background:radial-gradient(ellipse at 50% 50%,rgba(255,244,214,.60) 0%,rgba(255,196,92,.30) 38%,transparent 70%);
      animation:actD 2.6s ease-in-out infinite;mix-blend-mode:screen}
    @keyframes actD{0%,100%{opacity:.6;transform:scale(.94)}50%{opacity:1;transform:scale(1.06)}}
    /* the chevron that says "this one is up", above the head, billboarded */
    .actMark{position:absolute;width:0;height:0;border-left:9px solid transparent;
      border-right:9px solid transparent;border-top:12px solid rgba(255,232,170,.95);
      filter:drop-shadow(0 1px 3px rgba(0,0,0,.9));animation:actBob 1.8s ease-in-out infinite}
    @keyframes actBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
    
    /* ── aiming ────────────────────────────────────────────────────────────── */
    .aimRead{position:absolute;transform-origin:50% 100%;transform:rotateZ(var(--unspin, 0deg)) rotateX(var(--anti));
      width:174px;background:rgba(10,9,7,.95);border:1px solid #5c3028;border-radius:3px;
      padding:7px 9px;pointer-events:none;z-index:70}
    .aimRead .th{font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:#f09a8a;
      border-bottom:1px solid #3a2620;padding-bottom:4px;margin-bottom:5px;font-weight:600}
    .aimRead .row{display:flex;justify-content:space-between;font-size:11.5px;color:#c8c1b1}
    .aimRead .row b{color:#fff}
    .aimRead .tot{border-top:1px solid #3a2620;margin-top:5px;padding-top:5px;font-size:13px}
    .aimRead.bad{border-color:#6a2a2a}
    .aimRead.bad .th{color:#ff8b8b}
    .abRow.armed{background:#241310;box-shadow:inset 0 0 0 1px #6d3a30}
    .abRow.clickable{cursor:pointer}
    .abRow.clickable:hover{background:#1e1a13}
    .armTag{position:absolute;right:0;top:50%;transform:translateY(-50%);
      font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#f09a8a;
      background:#3a1c16;border:1px solid #6d3a30;padding:1px 5px;border-radius:2px}
    .railchip.done{filter:grayscale(.85) brightness(.55)}
    .railchip.now{border-color:#ffe2a0;box-shadow:0 0 0 1px #ffe2a0,0 0 12px rgba(255,226,160,.55)}
    
    /* ── glyph badges ──────────────────────────────────────────────────────── */
    .badges{position:absolute;display:flex;gap:3px}
    .badge{width:19px;height:19px;position:relative}
    .badge .gl{position:absolute;inset:0}
    .pip{position:absolute;right:-3px;bottom:-3px;min-width:12px;height:12px;border-radius:6px;
      font-size:9px;line-height:12px;text-align:center;font-weight:700;color:#0b0a08;
      padding:0 2px;border:1px solid rgba(0,0,0,.6)}
    .pip.sq{border-radius:2px}
    
    /* bars */
    .hpbar{position:absolute;width:6px;border-radius:1px;background:rgba(8,8,6,.8);
      border:1px solid rgba(0,0,0,.7);overflow:hidden;display:flex;flex-direction:column-reverse}
    .hpfill{width:100%;background:var(--hp)}
    .protbar{position:absolute;width:5px;display:flex;flex-direction:column-reverse;gap:1px}
    .protseg{width:100%;height:5px;background:var(--prot);border:1px solid rgba(0,0,0,.6)}
    .protseg.drain{animation:fxDrain 1.1s ease-in-out infinite}
    @keyframes fxDrain{0%,100%{opacity:1}50%{opacity:.25}}
    .movechip{position:absolute;font-size:10px;font-weight:700;padding:1px 5px;border-radius:2px;
      background:rgba(10,9,6,.82);border:1px solid #4a4133;color:#ded4bd;white-space:nowrap}
    
    /* floating damage */
    .dmg{position:absolute;font-family:Spectral,serif;font-weight:600;font-size:34px;
      text-shadow:0 2px 5px #000,0 0 12px rgba(0,0,0,.9);animation:fxFloat 2.6s ease-out infinite}
    @keyframes fxFloat{0%{opacity:0;transform:translateY(6px) scale(.7)}
      14%{opacity:1;transform:translateY(-6px) scale(1.15)}
      30%{transform:translateY(-14px) scale(1)}
      75%{opacity:1}100%{opacity:0;transform:translateY(-46px)}}
    
    /* ── ground fx keyframes ───────────────────────────────────────────────── */
    @keyframes fxFlicker{0%,100%{opacity:.55;transform:scaleY(1)}50%{opacity:.95;transform:scaleY(1.13)}}
    @keyframes fxEmber{0%{transform:translate(0,0);opacity:0}18%{opacity:1}100%{transform:translate(7px,-48px);opacity:0}}
    @keyframes fxSparkle{0%,100%{opacity:.14}50%{opacity:1}}
    @keyframes fxBubble{0%{transform:translateY(0) scale(.6);opacity:0}30%{opacity:.9}100%{transform:translateY(-26px) scale(1);opacity:0}}
    @keyframes fxPulse{0%,100%{opacity:.5}50%{opacity:1}}
    @keyframes fxSteam{0%{transform:translateY(0) scale(.5);opacity:0}25%{opacity:.75}100%{transform:translateY(-42px) scale(1.7);opacity:0}}
    @keyframes fxTrap{0%,100%{opacity:.55}50%{opacity:1}}
    @keyframes fxMarch{to{background-position:24px 0}}
    /* §11.3 — two tempos, deliberately different. Targeting is modal and urgent;
       an aura is ambient and must never read as "act now". */
    @keyframes fxTarget {0%,100%{opacity:.72}50%{opacity:1}}       /* 1.6–2.1s pulse   */
    @keyframes fxBreathe{0%,100%{opacity:.52}50%{opacity:.92}}     /* 4.4–5.6s breathe */
    @keyframes fxRingPulse{0%,100%{opacity:.55;transform:scale(1)}50%{opacity:.95;transform:scale(1.015)}}
    @keyframes fxAoO{0%{opacity:0;transform:scale(.6)}25%{opacity:1;transform:scale(1.1)}
      55%{opacity:.5;transform:scale(1)}100%{opacity:0;transform:scale(1.25)}}
    @keyframes fxImpact{0%{opacity:0;transform:scale(.3)}18%{opacity:1;transform:scale(1)}
      100%{opacity:0;transform:scale(1.9)}}
    @keyframes fxClock{0%,100%{opacity:.7}50%{opacity:1}}
    .flame{position:absolute;border-radius:50% 50% 46% 46%/66% 66% 34% 34%;
      mix-blend-mode:screen;transform-origin:50% 100%}
    .ember{position:absolute;border-radius:50%}
    
    /* chips on the plane */
    .hazchip{position:absolute;transform-origin:50% 100%;transform:rotateZ(var(--unspin, 0deg)) rotateX(var(--anti));
      font-size:11px;font-weight:600;padding:3px 8px;border-radius:2px;white-space:nowrap;
      background:rgba(12,9,5,.88);border:1px solid #5c4620;color:#f2c877;pointer-events:none}
    .clockchip{position:absolute;transform-origin:50% 100%;transform:rotateZ(var(--unspin, 0deg)) rotateX(var(--anti));
      font-size:12px;font-weight:700;padding:2px 7px;border-radius:2px;
      background:rgba(30,6,6,.9);border:1px solid #7a2222;color:#ff9b9b;
      animation:fxClock 1.6s ease-in-out infinite;pointer-events:none}
    
    /* to-hit readout */
    #tohit{position:absolute;transform-origin:50% 100%;transform:rotateZ(var(--unspin, 0deg)) rotateX(var(--anti));
      width:186px;background:rgba(10,9,7,.94);border:1px solid #443a28;border-radius:3px;
      padding:7px 9px;pointer-events:none}
    #tohit .th{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--brass);
      border-bottom:1px solid #332c22;padding-bottom:4px;margin-bottom:5px;font-weight:600}
    #tohit .row{display:flex;justify-content:space-between;font-size:11.5px;color:#c8c1b1}
    #tohit .row b{color:#fff;font-weight:600}
    #tohit .tot{border-top:1px solid #332c22;margin-top:5px;padding-top:5px;font-size:13px}
    #tohit .crit{color:#ffcf6a}
    #tohit .foot{font-size:10px;color:var(--dim);margin-top:4px;font-style:italic}
    
    /* annotation pins */
    .pin{position:absolute;transform-origin:50% 50%;transform:rotateZ(var(--unspin, 0deg)) rotateX(var(--anti));
      width:22px;height:22px;border-radius:11px;background:#e0b95e;color:#0b0a08;
      font-size:11px;font-weight:700;line-height:22px;text-align:center;
      box-shadow:0 2px 6px rgba(0,0,0,.8);pointer-events:none;z-index:60}
    .pin.off{display:none}
    
    /* ── transport + log ───────────────────────────────────────────────────── */
    #transport{height:46px;flex:0 0 46px;display:flex;align-items:center;gap:8px;padding:0 16px;
      background:#13110d;border-top:1px solid var(--border)}
    .tbtn{background:#221d16;border:1px solid var(--border);color:var(--ink);padding:5px 12px;
      border-radius:2px;font:inherit;font-size:13px;cursor:pointer}
    .tbtn:hover{border-color:var(--brass)}
    .tbtn.on{background:var(--brass);color:#0b0a08;border-color:var(--brass);font-weight:600}
    #scrub{flex:1 1 auto;accent-color:var(--brass)}
    #logbox{height:176px;flex:0 0 176px;overflow-y:auto;background:#0c0b09;
      border-top:1px solid var(--border);padding:8px 16px;font-size:12.5px;line-height:1.62}
    .ln{color:#a7a091}
    .ln.turn{color:var(--brass);font-weight:600;border-top:1px solid #251f16;
      margin-top:5px;padding-top:5px}
    .ln.hero b{color:var(--gold)} .ln.enemy b{color:var(--violet)}
    .ln.dmg{color:#e8b0a8} .ln.down{color:#ff8f8f;font-weight:600}
    .ln.status{color:#b9d2a0} .ln.cur{background:#1b1811;color:#fff;
      box-shadow:-12px 0 0 #1b1811,12px 0 0 #1b1811}
    .ln .sq{color:#5f594c}
    
    /* ── PANEL ─────────────────────────────────────────────────────────────── */
    #panel{width:472px;height:1080px;flex:0 0 472px;background:var(--panel);
      border-left:1px solid var(--border);position:relative;overflow:hidden;
      display:flex;flex-direction:column}
    #panel::before{content:"";position:absolute;left:0;right:0;top:0;height:2px;
      background:linear-gradient(90deg,#8a6f34,var(--brass),#8a6f34)}
    #panel.enemy::before{background:linear-gradient(90deg,#5a3a7a,var(--violet),#5a3a7a)}
    .pTooth{height:5px;background:repeating-linear-gradient(90deg,
      rgba(214,178,94,.5) 0 1px,transparent 1px 7px);opacity:.5}
    .pId{padding:14px 18px 10px}
    .pName{font-family:Spectral,serif;font-size:26px;font-weight:600;line-height:1.1}
    .pRole{font-size:12px;color:var(--dim);margin-top:3px;letter-spacing:.02em}
    .pHex{font-size:11px;color:#6e6959;margin-top:2px}
    .pBlock{margin:0 18px 12px;background:var(--plate);border:1px solid var(--border);
      border-radius:3px;padding:11px 13px}
    .vitRow{display:flex;align-items:center;gap:9px;margin-bottom:8px}
    .vitRow:last-child{margin-bottom:0}
    .vitLab{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);width:44px}
    .vitTrack{flex:1;height:11px;background:#080705;border:1px solid #241f17;border-radius:2px;
      overflow:hidden;display:flex}
    .vitFill{height:100%}
    .vitNum{font-size:12.5px;width:66px;text-align:right;color:#ddd6c6}
    .pGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);
      border:1px solid var(--border);border-radius:2px;overflow:hidden}
    .pCell{background:var(--plate);padding:7px 4px;text-align:center}
    .pCell .k{font-size:9.5px;letter-spacing:.11em;color:var(--dim);text-transform:uppercase}
    .pCell .v{font-size:19px;font-weight:600;margin-top:1px}
    .pChips{display:flex;flex-wrap:wrap;gap:5px;padding:0 18px 12px}
    .chip{display:flex;align-items:center;gap:4px;font-size:11.5px;font-weight:600;
      padding:2px 8px 2px 5px;border-radius:2px;border:1px solid}
    .chip i{width:11px;height:11px;display:block}
    .pArtWrap{display:flex;gap:13px;padding:0 18px 12px}
    .pArt{width:248px;height:372px;flex:0 0 248px;background:#0a0906;border:1px solid var(--border);
      border-radius:3px;overflow:hidden;position:relative}
    .pArt img{width:100%;height:100%;object-fit:contain;display:block}
    .pArt::after{content:"";position:absolute;inset:0;pointer-events:none;
      box-shadow:inset 0 0 46px rgba(0,0,0,.5)}
    .pArtLab{position:absolute;left:0;right:0;bottom:0;font-size:10px;text-align:center;
      padding:3px;background:rgba(8,7,5,.85);color:#9a9484;letter-spacing:.04em}
    .pSide{flex:1;display:flex;flex-direction:column;gap:9px}
    .pStam{background:var(--plate);border:1px solid var(--border);border-radius:3px;padding:9px 10px}
    .pStamTop{display:flex;justify-content:space-between;align-items:baseline}
    .pStamK{font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim)}
    .pStamV{font-size:21px;font-weight:600;color:#ffd98a}
    .pStamPips{display:flex;gap:2px;margin-top:6px;flex-wrap:wrap}
    .sp{width:8px;height:13px;border-radius:1px;background:#2a2318;border:1px solid #3a3122}
    .sp.on{background:#e0b95e;border-color:#f0cf85}
    /* ── ability list — DEFINED BOXES, as the approved screen has them.
       Each row is its own plate with its own border: a 3px class rule, a 26px icon
       plate, name + description, then four 40×24 boxed cells. ─────────────────── */
    .pAb{flex:1;margin:0 18px;overflow-y:auto;border-top:1px solid var(--border);padding-top:8px}
    .abHead{display:flex;align-items:center;gap:6px;
      font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim);
      padding:2px 0 7px;position:sticky;top:0;background:var(--panel);z-index:2}
    .abHead .hcell{width:40px;text-align:center;flex:0 0 40px}
    .abLegend{display:flex;gap:10px;font-size:9px;align-items:center;flex:1}
    .abLegend i{width:8px;height:8px;display:inline-block;margin-right:3px;vertical-align:-1px}
    .abRow{display:flex;align-items:center;gap:10px;padding:8px 11px 8px 8px;
      border-radius:3px;margin-bottom:6px;position:relative;
      transition:box-shadow .12s, background .12s}
    .abRule{flex:0 0 3px;align-self:stretch;border-radius:2px;min-height:30px}
    .abIcon{flex:0 0 26px;height:26px;border-radius:3px;display:flex;
      align-items:center;justify-content:center}
    .abIcon i{width:13px;height:13px;display:block}
    .abMid{flex:1;min-width:0}
    .abT{font:600 14px/1.2 "Barlow Semi Condensed",ui-sans-serif,sans-serif;
      letter-spacing:.01em;color:#efe9da;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .abSub{font:10.5px/1.35 ui-monospace,SFMono-Regular,Menlo,monospace;color:#8b8778;
      margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .abCells{flex:0 0 auto;display:flex;align-items:center;gap:6px}
    .abCell{width:40px;height:24px;border-radius:2px;background:#100e0a;
      border:1px solid #332c22;color:#c9c5b8;
      font:700 11px/22px ui-monospace,SFMono-Regular,Menlo,monospace;text-align:center}
    .abCell.cost{border-color:#3d3427;color:#e8e5dc}
    .abCell.dmg.on{background:#2a1310;border-color:#4a231c;color:#eda393}
    .abCell.cd.on{background:#231b09;border-color:#4a3c17;color:var(--brass)}
    .abCell.blank{color:#4a453b}
    /* the log says this power fired — the row announces it, then settles */
    @keyframes abFire{
      0%  {box-shadow:0 0 0 0 rgba(255,214,140,0);   background:var(--rowbg)}
      12% {box-shadow:0 0 0 2px #ffd98a, 0 0 20px rgba(255,200,110,.65); background:#3a2c14}
      30% {box-shadow:0 0 0 2px #ffd98a, 0 0 14px rgba(255,200,110,.45); background:#2e2411}
      55% {box-shadow:0 0 0 2px rgba(255,217,138,.5);background:#241c0e}
      100%{box-shadow:0 0 0 0 rgba(255,214,140,0);   background:var(--rowbg)}}
    .abRow.firing{animation:abFire 1.15s ease-out}
    .abRow.firing .abT{color:#fff5df}
    .pFoot{padding:9px 18px 13px;font-size:10.5px;color:#5f594c;border-top:1px solid var(--border)}
    /* who the panel is currently about */
    .pSubject{display:flex;align-items:center;gap:7px;padding:9px 18px 0}
    .pSubject b{font-size:10px;letter-spacing:.15em;text-transform:uppercase;
      padding:3px 9px;border-radius:2px;font-weight:700}
    .pSubject.acting b{background:#3a2c14;color:#ffd98a;border:1px solid #5c4620}
    .pSubject.target b{background:#3a1c16;color:#ff9b82;border:1px solid #6d3a30}
    .pSubject.inspect b{background:#1a222a;color:#8ab4d1;border:1px solid #2a3a44}
    .pSubject span{font-size:11px;color:#5f594c}
    
    /* ── page chrome outside the screen ────────────────────────────────────── */
    #docwrap{max-width:1500px;margin:0 auto;padding:26px 22px 80px}
    #doc h1{font-family:Spectral,serif;font-size:32px;margin:0}
    #doc .sub{color:var(--dim);max-width:86ch;margin-top:6px}
    #ctl{display:flex;gap:9px;flex-wrap:wrap;align-items:center;margin:16px 0 14px;
      background:var(--plate);border:1px solid var(--border);border-radius:4px;padding:12px 16px}
    #ctl label{font-size:12.5px;color:var(--dim)}
    #key{margin-top:26px;border-top:1px solid var(--border);padding-top:20px}
    #key h2{font-family:Spectral,serif;font-size:22px;margin:0 0 4px}
    .keygrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:0 26px;margin-top:14px}
    .keyrow{display:flex;gap:10px;padding:6px 0;border-bottom:1px solid #1c1812;font-size:13px}
    .keyno{width:24px;height:24px;flex:0 0 24px;border-radius:12px;background:var(--brass);
      color:#0b0a08;font-size:11px;font-weight:700;line-height:24px;text-align:center}
    .keyno.new{background:#7ec45f}
    .keytx b{display:block;font-size:13.5px}
    .keytx span{color:var(--dim);font-size:12px}
    
    
    /* PARCHMENT surround (ruled 2026-08-26): the space around the board is paper,
       not blackness. Layered CSS gradients — warm base, two light/shade blooms,
       faint fibre lines — with an aged-brown inset edge. */
    #boardwrap{background:url("data:image/jpeg;base64,") center/cover !important;}
    .ddOpt:hover{background:#2a2416 !important;color:#ffe2a0 !important}
    /* ── ACTION BAR (UI-BUILD-NOTES 9.1-9.6, built 2026-09-01) ─────────────────
       12 slots as 3 columns x 4 rows. The row is TWO LINES because a column is
       468px and the one-line anatomy needs ~492 — measured, not guessed. */
    #actionbar{height:256px;flex:0 0 256px;background:#0f0d0a;border-top:2px solid var(--brass);
      padding:10px 12px;display:grid;grid-template-columns:repeat(3,1fr);
      grid-template-rows:repeat(4,1fr);gap:6px 10px;align-content:stretch}
    /* two columns inside the row: identity + numbers on the left, cooldown and
       trigger chips in the right half that was previously empty (2026-09-01) */
    /* TOP-ALIGNED (fixed 2026-09-01): the row was centring its content inside a
       fixed-height cell, which slid the text down and let the right column spread
       apart. Everything now anchors to the top of the row, and the right column is
       a single line level with the name. */
    /* THREE ZONES (fixed 2026-09-01): identity+numbers left, trigger chips in the
       middle with room to WRAP, cooldown hard right. The previous two-zone version
       capped the chip area at 52% and let .acRow clip it, so a unit with three
       triggers rendered all three and showed only the first. */
    .acRow{position:relative;display:grid;
      grid-template-columns:minmax(0,1fr) minmax(0,1.05fr) auto;align-items:start;
      gap:0 9px;padding:7px 9px;border:1px solid #2b2418;border-radius:3px;background:#15120d;
      border-left-width:3px}
    .acMain{display:flex;flex-direction:column;gap:4px;min-width:0}
    /* STACKED, one per line (ruled 2026-09-01) — three triggers read as a list,
       not as a run-on sentence. Each chip fills the column so the words and the
       odds line up down the stack. */
    /* chips size to their own text — a short trigger takes a short box */
    .acTrgs{display:flex;flex-direction:column;align-items:flex-start;gap:2px;min-width:0}
    /* expanded lists FLOAT above the grid so opening one never resizes the rows */
    .acTrgs.open{position:absolute;right:46px;top:5px;z-index:30;background:#181510;
      border:1px solid #3a3223;border-radius:3px;padding:5px;
      box-shadow:0 8px 22px rgba(0,0,0,.75)}
    .acMore{margin-top:1px;padding:2px 6px;border:1px dashed #4a4232;border-radius:2px;
      background:#1c1811;color:#a9a394;cursor:pointer;white-space:nowrap;
      font:600 9.5px/1 'Barlow Semi Condensed',sans-serif;letter-spacing:.05em}
    .acMore:hover{background:#272115;color:#e8e5dc;border-color:#6b5a33}
    .acRow.empty{background:#100e0b;border-color:#1c1812;border-left-color:#1c1812}
    .acRow.firing{background:#3a2c14;border-color:#ffd98a;box-shadow:0 0 14px rgba(255,200,110,.5)}
    /* unusable: the ROW greys, the turn count stays bright (ruled 9.4) */
    .acRow.cool{opacity:.42}
    .acRow.cool .acCd{opacity:1;color:#ffd98a;border-color:#7a6330;background:#2a2113}
    .acL1{display:flex;align-items:center;gap:6px;min-width:0}
    .acL2{display:flex;align-items:center;gap:8px;font-family:ui-monospace,monospace;font-size:11.5px}
    .ra{display:inline-block;width:1em;height:1em;fill:currentColor;flex:none;vertical-align:-.125em}
    /* the action-row icon plate (HANDOFF §1.2/§2): 24px box, 15px glyph. Colour
       comes inline — damage hue on a damaging row, class colour otherwise. */
    .acIco{width:24px;height:24px;flex:0 0 24px;border-radius:2px;border:1px solid transparent;
      display:flex;align-items:center;justify-content:center;font-size:15px;line-height:1}
    .acName{font:600 15px/1.1 'Barlow Semi Condensed',sans-serif;color:#e8e5dc;
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    /* ── STAT BLOCK, layout B (ruled 2026-09-01) — two columns of rows, name
       left, figure hard right. Green when a modifier raises the stat, red when
       one lowers it; bone when untouched. */
    .stCols{display:grid;grid-template-columns:1fr 1fr;gap:0 22px}
    .stRow{display:flex;align-items:baseline;justify-content:space-between;gap:10px;
      padding:5px 2px;border-bottom:1px solid #241f17}
    .stRow:last-child{border-bottom:none}
    .stN{font:600 13px 'Barlow Semi Condensed',sans-serif;letter-spacing:.02em;color:#a9a394}
    .stV{font:700 15px ui-monospace,monospace;font-variant-numeric:tabular-nums;
      white-space:nowrap;color:#e8e5dc}
    .stV em{font-style:normal;font-size:10px;font-weight:700;opacity:.85;margin-right:4px}
    .stV s{text-decoration:none;font-size:11px;opacity:.7}
    
    /* STAMINA sits directly above the action bar (ruled 2026-09-01) — beside the
       rows it pays for, not buried in the panel. Long bar, number to the right. */
    /* the stamina strip uses the ACTION BAR'S OWN GRID so the bar is exactly the
       width of the moves column — one third, aligned to it (ruled 2026-09-01) */
    #stambar{height:34px;flex:0 0 34px;display:grid;grid-template-columns:repeat(3,1fr);
      gap:0 10px;padding:0 12px;background:#12100c;border-top:1px solid var(--border);
      align-items:center}
    #stambar .cell1{display:flex;align-items:center;gap:9px;min-width:0}
    #stambar .lab{font:700 10px 'Barlow Semi Condensed',sans-serif;letter-spacing:.13em;
      text-transform:uppercase;color:#8b8778;flex:0 0 auto}
    #stambar .track{flex:1;height:12px;background:#080705;border:1px solid #241f17;
      border-radius:2px;overflow:hidden;display:flex;gap:2px;padding:2px}
    /* NOT .pip — that class is already the status-count pip, and it is
       position:absolute with its own offsets, so stamina pips using the same name
       stacked outside the track and read as empty (fixed 2026-09-01). */
    #stambar .sPip{position:static;flex:1 1 0;min-width:0;height:auto;border-radius:1px;
      background:#2a2418;border:none}
    #stambar .sPip.on{background:linear-gradient(#f0cf7a,#c9a352);
      box-shadow:0 0 4px rgba(224,185,94,.5)}
    #stambar .num{font:700 15px ui-monospace,monospace;color:#e8e5dc;flex:0 0 auto;
      font-variant-numeric:tabular-nums}
    #stambar .who{font:600 12px 'Barlow Semi Condensed',sans-serif;color:#6f6857;flex:0 0 auto}
    /* the weapon, shown only when two actions share a display name */
    .acFrom{font-weight:600;font-size:11px;color:#7f7869;margin-left:6px;letter-spacing:.04em}
    .acTag{font:600 10px/1 'Barlow Semi Condensed',sans-serif;letter-spacing:.05em;
      text-transform:uppercase;color:#8b8778;background:#201a12;border:1px solid #322a1c;
      border-radius:2px;padding:2px 5px;white-space:nowrap;flex:0 0 auto}
    .acCell{display:flex;align-items:center;gap:3px;white-space:nowrap}
    .acCell .k{font-size:8.5px;letter-spacing:.09em;color:#6f6857;font-family:'Barlow Semi Condensed',sans-serif}
    .acCell .v{font-weight:700;color:#cfc9ba}
    /* triggers this action can fire — abbreviated to the word, in the status's
       own hue, stacked in the row's right half */
    .acTrg{display:flex;align-items:baseline;
      font:600 10px/1 'Barlow Semi Condensed',sans-serif;letter-spacing:.03em;
      padding:2px 5px;border:1px solid;border-radius:2px;background:#00000038;
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    /* the chance is NOT the effect's colour (ruled 2026-09-01) — the word carries
       the status hue, the odds stay grey so they read as odds */
    .acTrg b{font-size:10.5px;font-weight:700;margin-left:4px;
      font-family:ui-monospace,monospace;font-variant-numeric:tabular-nums}
    .acTrg i{font-style:normal;font-size:9px;font-weight:700;color:#8b8778;margin-left:6px;
      font-family:ui-monospace,monospace;font-variant-numeric:tabular-nums}
    .acCd{align-self:start;padding:1px 6px;border-radius:2px;border:1px solid #2b2418;
      background:#16130e;color:#8b8778;font-weight:700}
    .acHint{position:absolute;right:8px;top:6px;font:600 8.5px/1 'Barlow Semi Condensed',sans-serif;
      letter-spacing:.1em;color:#5f594c;text-transform:uppercase}
    /* FULL-WIDTH (ruled 2026-08-27): the viewer fills the window. The doc column
       cap and the 1x scale cap both came from the reference page's document
       framing; the intro prose keeps its own readable measure. */
    #docwrap{max-width:none !important;padding:10px 10px 46px !important}
    #doc{max-width:1400px;margin:0 auto 4px}
    #boardwrap::after{background:none !important;
      box-shadow:inset 0 0 130px 48px rgba(96,70,36,.42) !important;}
    /* ── OFF-SCREEN UNIT INDICATORS (PLAYBACK-DESIGN §7.8, 2026-09-02) ────────
       a bubble at the viewport edge: the unit's art, an arrow toward it, a count,
       the danger numeral for enemies. Screen space, outside the 3D scene. */
    .edgeBub{position:absolute;width:44px;height:44px;margin:-22px 0 0 -22px;border-radius:50%;
      border:2px solid;background:rgba(10,9,7,.88);box-shadow:0 2px 10px rgba(0,0,0,.7);
      display:flex;align-items:center;justify-content:center}
    .edgeArt{position:absolute;inset:4px;border-radius:50%;background-size:cover;background-position:center 15%}
    .edgeArrow{position:absolute;left:50%;top:50%;width:0;height:0;margin:-7px 0 0 -4px;
      border:7px solid transparent;border-right:none;border-left-width:11px}
    .edgeN{position:absolute;right:-6px;top:-6px;min-width:18px;height:18px;border-radius:9px;padding:0 4px;
      font:700 11px/18px ui-monospace,monospace;color:#0d0c0a;text-align:center;box-shadow:0 1px 3px #000}
    .edgeDg{position:absolute;left:50%;bottom:-13px;transform:translateX(-50%);display:flex;align-items:center;gap:2px;
      font:700 12px/1 ui-monospace,monospace;color:#c3bdb0;text-shadow:0 1px 3px #000,0 0 6px #000;white-space:nowrap}
    
    /* ── the injury plate (emphasis ladder rung 3, 2026-09-02) — lands on the token,
       holds, flies to the panel. The one thing that moves between board and panel. */
    .injPlate{position:absolute;padding:6px 10px;border-radius:3px;background:#1d100e;border:1px solid #ffb0a4;
      box-shadow:0 0 18px rgba(255,120,100,.45),0 4px 12px rgba(0,0,0,.8);color:#ffb0a4;text-align:center;
      font:700 15px/1.2 'Barlow Semi Condensed',sans-serif;letter-spacing:.03em;white-space:nowrap;pointer-events:none}
    .injPlate b{color:#ffcf6a;margin-right:4px}
    
    /* Terrain canvas shares the board's unscaled layout viewport. CSS stage
       projection is mirrored by its camera; outer page-fit scales both once. */
    .terrain3d-canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0}
    #stage{z-index:1}
    .terrain3d-ready #stage .cell{background-image:none !important}
    .terrain3d-ready #stage .props{visibility:hidden}
    #terrainStatus{position:absolute;right:14px;bottom:10px;z-index:50;background:#14120e;color:#d8cfae;padding:4px 10px;border:1px solid #4a3a1c;font-size:12px;max-width:65%}
    #battleDD{position:relative;width:min(760px,100%);margin:12px 0;z-index:1000}
    #battleLabel{display:block;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:var(--brass);margin-bottom:5px}
    #battleBtn{display:block;width:100%;text-align:left;padding:12px 16px;font-size:18px;border:1px solid var(--brass);background:#201b12;color:var(--ink);cursor:pointer}
    #battleBtn:focus-visible,#battleMenu:focus-visible{outline:3px solid var(--brass);outline-offset:3px}
    #battleMenu{position:absolute;top:100%;left:0;right:0;max-height:min(60vh,480px);overflow-y:auto;background:#14120e;border:1px solid var(--brass);box-shadow:0 12px 30px #000;z-index:1001}
    .ddOpt{padding:10px 16px;cursor:pointer;border-bottom:1px solid var(--border);white-space:normal}
    .ddOpt[aria-selected="true"]{color:var(--brass);font-weight:700}
    .ddOpt.focused,.ddOpt:hover{background:#3a3020}
    .atlas-link{display:inline-block;color:#d7cc9d;margin:0 0 12px;text-decoration:underline}
    
    /* Authored burst payload stays readable in its full tooltip without widening the action row. */
    .acTag.burstTag{min-width:0;max-width:145px;overflow:hidden;text-overflow:ellipsis;flex:1 1 auto}
    
    /* Native targeting buttons retain a visible keyboard focus within the hex clip. */
    .targetHex:focus-visible{background:rgba(255,215,100,.35)!important;box-shadow:inset 0 0 0 5px #ffd764;outline:none}
    
    /* ── viewer.painted-board (2026-09-29): Reset returns the starting angled view ── */
    #camReset{position:absolute;right:14px;bottom:10px;z-index:50;font:600 11px/1 "Barlow Semi Condensed",ui-sans-serif,system-ui,sans-serif;
      letter-spacing:.12em;text-transform:uppercase;color:var(--ink);background:rgba(8,9,11,.78);border:1px solid var(--brass);
      border-radius:2px;padding:7px 11px;cursor:pointer}
    #camReset:hover{background:#2a2110}
    
    /* ── viewer.under-unit (2026-09-29): under the unit its name, Health, Protection and compact icons; Stun, Burn and
       Poison on the body (engine DECISIONS.md "the playable battle screen"; board.js UU and BODY_FX) ── */
    .uuName{position:absolute;text-align:center;white-space:nowrap;pointer-events:none;transform:translateZ(60px);
      font:700 12px/1 'Barlow Semi Condensed',ui-sans-serif,system-ui,sans-serif;letter-spacing:.03em;
      text-shadow:0 1px 3px #000,0 0 8px rgba(0,0,0,.95),0 0 2px #000}
    .uuIcons .badge{width:15px;height:15px}
    .uuIcons .pip{min-width:10px;height:10px;font-size:8px;line-height:10px;right:-3px;bottom:-3px}
    .uuFx{position:absolute;left:0;top:0;width:0;height:0;pointer-events:none;transform:translateZ(8px);transform-style:preserve-3d}
    .uuStar{position:absolute;left:-6px;top:-6px;width:12px;height:12px;animation:uuOrbit 1.5s linear infinite}
    @keyframes uuOrbit{0%{transform:translate(18px,0) scale(1)}12.5%{transform:translate(12.7px,4.2px) scale(1.08)}
      25%{transform:translate(0,6px) scale(1.15)}37.5%{transform:translate(-12.7px,4.2px) scale(1.08)}
      50%{transform:translate(-18px,0) scale(1)}62.5%{transform:translate(-12.7px,-4.2px) scale(.82);opacity:.8}
      75%{transform:translate(0,-6px) scale(.66);opacity:.6}87.5%{transform:translate(12.7px,-4.2px) scale(.82);opacity:.8}
      100%{transform:translate(18px,0) scale(1)}}
    
    /* viewer.play-input (2026-09-30): the chosen action on the bar, the planning note over the board */
    .acRow.playChosen{border-color:#bff2ff;box-shadow:0 0 12px rgba(150,205,245,.55)}
    #playNote{position:absolute;left:50%;top:12px;transform:translateX(-50%);z-index:50;padding:4px 12px;border:1px solid #2a251d;border-radius:2px;
      background:rgba(8,9,11,.82);color:#e8dfc8;font:600 13px "Barlow Semi Condensed",ui-sans-serif,system-ui,sans-serif;pointer-events:none}
    .playHex:focus-visible{background:rgba(150,205,245,.3)!important;outline:none}
    
    /* ── viewer.play-chrome (2026-09-30): End Turn and its pop-up, End activation, 2×, the battle log (src/chrome.js;
       engine DECISIONS.md 2026-09-29 "the playable battle screen"; viewer SWITCHES.md playChrome*) ── */
    #playChrome{position:absolute;right:14px;bottom:44px;z-index:60;display:flex;gap:8px;align-items:stretch}
    /* viewer.battle-full-screen (engine DECISIONS.md 2026-09-30): End activation and End Turn sit in the screen's lower
       right-hand corner — the foot of the right-hand panel, beside the action bar — never on the board; the panel gives
       them its last rows */
    #playEnds{position:absolute;right:0;bottom:0;width:472px;box-sizing:border-box;z-index:70;display:flex;gap:10px;
      justify-content:flex-end;align-items:stretch;padding:14px 18px 18px;background:var(--panel);
      border-left:1px solid var(--border);border-top:1px solid var(--border)}
    #playEnds .pcBtn{flex:1 1 0;padding:14px 12px}
    #playEnds .pcBtn.pcEnd{flex:1.3 1 0}
    .pcEndsOn #panel{padding-bottom:84px;box-sizing:border-box}
    .pcBtn{font:600 13px/1 "Barlow Semi Condensed",ui-sans-serif,system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;
      color:var(--ink);background:rgba(8,9,11,.84);border:1px solid var(--brass);border-radius:2px;padding:9px 14px;cursor:pointer}
    .pcBtn:hover{background:#2a2110}
    .pcBtn.on{background:var(--brass);color:#0b0a08}
    .pcBtn.pcEnd{font-size:17px;padding:12px 22px;background:#3a2a10;color:var(--gold);box-shadow:0 0 14px rgba(224,185,94,.35)}
    .pcBtn.pcEnd:hover{background:#4a3614}
    .pcBtn.pcOff,.pcBtn.pcEnd.pcOff{opacity:.38;cursor:default;box-shadow:none;background:rgba(8,9,11,.84)}
    .pcBtn:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
    #playLog{position:absolute;left:14px;bottom:34px;z-index:55;width:560px;height:232px;overflow-y:auto;padding:8px 12px;
      background:rgba(12,11,9,.86);border:1px solid #2a251d;border-radius:2px;font:12px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace}
    /* a log row's "dmg" class is also the board's damage float (.dmg: absolute, 34px, animated) — not in the log */
    #playLog .ln.dmg{position:static;font-family:inherit;font-size:inherit;font-weight:inherit;text-shadow:none;animation:none}
    #playAsk{position:absolute;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.55)}
    #playAskBox{max-width:560px;padding:26px 30px 22px;background:#15120d;border:1px solid var(--brass);border-radius:3px;
      box-shadow:0 24px 60px rgba(0,0,0,.8),0 0 0 1px #000;color:var(--ink);font:500 18px/1.4 "Barlow Semi Condensed",ui-sans-serif,system-ui,sans-serif}
    #playAskText{margin:0 0 10px;font-size:21px;color:var(--gold)}
    #playAskWho{margin:0 0 20px;color:#b9b09a;font-size:15px}
    #playAskBtns{display:flex;gap:12px;justify-content:flex-end}
    
