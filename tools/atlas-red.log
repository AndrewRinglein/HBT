    '      <button class="tbtn" id="bareBtn">units only</button>\r\n' +
    '      <button class="tbtn on" id="zoomBtn">1&times; native</button>\r\n' +
    '      <button class="tbtn" id="logBtn">log</button>`\r\n' +
    "  const logbox = document.createElement('div'); logbox.id = 'logbox'; logbox.style.display = 'none'\r\n" +
