  "overrides": {
    "note": "Patches to what the SOURCE gave a creature, where the source content is right but its shape or radius was not. Distinct from a rider (which adds) and from reauthored (which replaces): this edits a ported trigger in place. Ruled 2026-08-22. Extended 2026-08-22 to patch a named ATTACK as well as a ported trigger, which is what the row re-authoring needed.",
    "units": {
      "unit.fallen-priest": [
        {
          "hook": "onActivationEnd",
          "why": "Ruled: heal allies 2 within 4. NOTE - regeneration and heal are NOT the same thing, so the aura of regeneration I had authored here was not a duplicate of this, it was a different mechanic. The source heal is what the priest does; my regeneration aura is dropped.",
          "set": {
            "targets": "allies within N hexes",
            "range": 4
          }
        }
      ],
      "unit.bone-mite": [
        {
          "hook": "onDeath",
          "why": "Ruled: +1 armor to ALL allies within radius 2, not to one ally. A mite that dies and hardens the swarm around it.",
          "set": {
            "targets": "allies within N hexes",
            "range": 2
          }
        }
      ],
      "unit.bone-dragon": [
        {
          "attack": "Claw Sweep",
          "why": "attacksAllInRow. A SWEEP takes several things standing in reach - that is the multiple-attacks shape, not a row.",
          "set": {
            "targets": "up to N enemies within Reach",
            "multiple": {
              "count": 3,
              "damageModifier": 0
            }
          }
        },
        {
          "attack": "Poison Breath",
          "why": "attacksAllInRow. A BREATH covers ground: it lands somewhere and catches what is around it. Not a radius centred on the dragon.",
          "set": {
            "targets": "a hex within N hexes and every hex adjacent to it",
            "range": 3
          }
        }
      ],
      "unit.hellwasp-drone": [
