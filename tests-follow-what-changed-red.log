    const hues = [...theme.matchAll(/hue:\\s*'(#[0-9a-f]{6})'/g)].map(m => m[1])
    const leaks = []
    const walk = d => { for (const f of readdirSync(d)) { const p = join(d, f); if (statSync(p).isDirectory()) walk(p)
